<div class="max-w-4xl mx-auto px-6 py-12">
  <!-- Header -->
  <%= render FlatPack::PageHeader::Component.new(
    title: "🎉 CaptainHook Engine",
    subtitle: "Your Rails mountable engine is running successfully!",
    class: "mb-10"
  ) %>

  <!-- Grid of Cards -->
  <div class="grid gap-6 mb-6">
    <!-- What's Working Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold">✅ What's Working</h2>
      <% end %>
      <% card.body do %>
        <ul class="space-y-2.5 text-sm">
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            Rails Engine mounted and operational
          </li>
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            PostgreSQL with UUID primary keys
          </li>
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            TailwindCSS styling (Auto rebuilds. See below)
          </li>
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            Codespace environment automatically setups dummy app on build
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Rename Your Gem Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold">🚀 Next Steps: Rename Your Gem</h2>
      <% end %>
      <% card.body do %>
        <ul class="space-y-2.5 text-sm">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>This gem is currently named <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">captain_hook</code></span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Run <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">bin/rename_gem your_gem_name</code> to rename it</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Or ask AI: <em class="text-gray-500">"Rename this gem to my_engine using the rename script"</em></span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>See <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">docs/RENAMING.md</code> for details</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Verify: run tests and check the dummy app starts</span>
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Tailwind CSS Card -->
    <!-- Tailwind CSS Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold">🎨 Tailwind CSS</h2>
      <% end %>
      <% card.body do %>
        <ul class="space-y-2.5 text-sm">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>CSS is prebuilt when Codespaces starts</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Tailwind auto-rebuilds if you start the server with <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">cd test/dummy && bin/dev</code> (See test/dummy/Procfile.dev)</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>In production, the parent app's Tailwind build compiles the gem's styles — run <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">rails g captain_hook:install</code> to automatically add the gem's view paths to the parent's Tailwind config</span>
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Installing in a Rails App Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold">📦 Installing in a Rails App</h2>
      <% end %>
      <% card.body do %>
        <p class="text-sm text-gray-500 mb-4">
          This gem includes an install generator to set up everything automatically:
        </p>
        <ol class="space-y-2.5 text-sm list-decimal list-inside mb-4">
          <li>Add the gem to your app's <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">Gemfile</code> and run <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">bundle install</code></li>
          <li>Run <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">rails generate captain_hook:install</code></li>
        </ol>
        <p class="text-sm font-medium mb-2">The generator will:</p>
        <ul class="space-y-2.5 text-sm">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Mount the engine at <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">/captain_hook</code> in your routes</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Configure Tailwind CSS to include the gem's views (if Tailwind is detected)</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Display post-installation instructions</span>
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Template Features Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold">⚡ Template Features</h2>
      <% end %>
      <% card.body do %>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Rename Script</strong> — Run <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">bin/rename_gem your_gem_name</code> to rename the entire gem (files, classes, modules, and references)</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Engine Hooks</strong> — Customize engine behavior from your host app with lifecycle hooks (<code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">before_initialize</code>, <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">after_initialize</code>), service hooks, and model/controller extensions</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Service Objects</strong> — Business logic encapsulated in services with Result monad pattern for clean success/failure handling</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Install Generator</strong> — Run <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">rails g captain_hook:install</code> to mount the engine, create config initializer, and configure Tailwind</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Migrations Generator</strong> — Run <code class="px-2 py-0.5 bg-gray-100 text-blue-700 rounded text-xs font-mono">rails g captain_hook:migrations</code> to copy engine migrations to your host app</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Configuration DSL</strong> — Simple configuration API with YAML and initializer support</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">UUID Primary Keys</strong> — PostgreSQL UUIDs out of the box for all models</span>
          </li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>



