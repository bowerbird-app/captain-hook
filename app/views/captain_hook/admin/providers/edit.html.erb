<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render FlatPack::Breadcrumb::Component.new(class: "mb-6") do |breadcrumb| %>
    <% breadcrumb.item(text: "Providers", href: admin_providers_path) %>
    <% breadcrumb.item(text: @registry_config&.display_name || @provider.name.titleize, href: admin_provider_path(@provider)) %>
    <% breadcrumb.item(text: "Edit") %>
  <% end %>

  <h1 class="text-3xl font-bold text-gray-900 mb-6">Edit Provider</h1>

  <%= form_with model: [:admin, @provider], local: true do |f| %>
    <% if @provider.errors.any? %>
      <%= render FlatPack::Alert::Component.new(
        style: :danger,
        title: "#{pluralize(@provider.errors.count, "error")} prohibited this provider from being saved:",
        class: "mb-6"
      ) do %>
        <ul class="list-disc list-inside mt-2 space-y-1 text-sm">
          <% @provider.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated, class: "mb-6") do |card| %>
      <% card.header do %>
        <h5 class="font-semibold">Basic Information</h5>
      <% end %>
      <% card.body do %>
        <div class="space-y-6">
          <div>
            <%= render FlatPack::TextInput::Component.new(
              name: "provider[name]",
              label: "Name",
              value: @provider.name,
              disabled: true
            ) %>
            <p class="text-xs text-gray-500 mt-2">Provider name cannot be changed after creation</p>
          </div>

          <% if @registry_config&.display_name.present? %>
            <div>
              <%= render FlatPack::TextInput::Component.new(
                name: "display_name",
                label: "Display Name",
                value: @registry_config.display_name,
                disabled: true
              ) %>
              <p class="text-xs text-gray-500 mt-2">Display name is configured in the provider's YAML file</p>
            </div>
          <% end %>

          <% if @registry_config&.description.present? %>
            <div>
              <%= render FlatPack::TextArea::Component.new(
                name: "description",
                label: "Description",
                value: @registry_config.description,
                rows: 3,
                disabled: true
              ) %>
              <p class="text-xs text-gray-500 mt-2">Description is configured in the provider's YAML file</p>
            </div>
          <% end %>

          <div>
            <%= hidden_field_tag "provider[active]", "0" %>
            <%= render FlatPack::Checkbox::Component.new(
              name: "provider[active]",
              value: "1",
              label: "Active Status — Provider is active",
              checked: @provider.active
            ) %>
            <p class="text-xs text-gray-500 mt-2">Inactive providers won't accept webhooks</p>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated, class: "mb-6") do |card| %>
      <% card.header do %>
        <h5 class="font-semibold">Authentication</h5>
      <% end %>
      <% card.body do %>
        <div class="space-y-4">
          <%= render FlatPack::Alert::Component.new(style: :info) do %>
            <strong>ℹ️ Note:</strong> The signing secret is configured in the provider's YAML file.
            <% if @registry_config&.raw_signing_secret.present? %>
              <br>Current value: <code class="bg-gray-100 px-2 py-1 rounded text-xs"><%= @registry_config.raw_signing_secret.start_with?('ENV[') ? @registry_config.raw_signing_secret : @registry_config.raw_signing_secret.truncate(20) %></code>
            <% end %>
          <% end %>

          <%= render FlatPack::Alert::Component.new(style: :warning) do %>
            <strong>⚠️ Security Note:</strong> The webhook token (<code class="bg-amber-100 px-2 py-1 rounded text-xs"><%= @provider.token.truncate(20) %></code>) cannot be changed.
            If you need a new token, you must create a new provider.
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated, class: "mb-6") do |card| %>
      <% card.header do %>
        <h5 class="font-semibold">Security Settings</h5>
      <% end %>
      <% card.body do %>
        <div class="space-y-6">
        <div>
          <%= render FlatPack::NumberInput::Component.new(
            name: "provider[timestamp_tolerance_seconds]",
            label: "Timestamp Tolerance Seconds",
            value: @provider.timestamp_tolerance_seconds
          ) %>
          <p class="text-xs text-gray-500 mt-2">Timestamp tolerance in seconds</p>
        </div>

        <div>
          <%= render FlatPack::NumberInput::Component.new(
            name: "provider[max_payload_size_bytes]",
            label: "Max Payload Size Bytes",
            value: @provider.max_payload_size_bytes
          ) %>
          <p class="text-xs text-gray-500 mt-2">Maximum payload size in bytes</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= render FlatPack::NumberInput::Component.new(
              name: "provider[rate_limit_requests]",
              label: "Rate Limit (requests)",
              value: @provider.rate_limit_requests
            ) %>
          </div>
          <div>
            <%= render FlatPack::NumberInput::Component.new(
              name: "provider[rate_limit_period]",
              label: "Rate Limit (period in seconds)",
              value: @provider.rate_limit_period
            ) %>
          </div>
        </div>
        </div>
      <% end %>
    <% end %>

    <div class="flex gap-2">
      <%= render FlatPack::Button::Component.new(
        text: "Update Provider",
        style: :primary,
        type: "submit"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Cancel",
        url: [:admin, @provider],
        style: :secondary
      ) %>
    </div>
  <% end %>

  <div class="mt-6 pt-6 border-t border-gray-200">
    <%= form_with url: [:admin, @provider], method: :delete, data: { turbo_confirm: "Are you sure? This will permanently delete this provider and cannot be undone." } do %>
      <%= render FlatPack::Button::Component.new(
        text: "Delete Provider",
        style: :error,
        type: "submit"
      ) %>
    <% end %>
  </div>
</div>
