<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render FlatPack::Breadcrumb::Component.new(class: "mb-6") do |breadcrumb| %>
    <% breadcrumb.item(text: "Providers", href: admin_providers_path) %>
    <% breadcrumb.item(text: "New Provider") %>
  <% end %>

  <%= render FlatPack::PageHeader::Component.new(title: "Add New Provider") %>

  <%= form_with model: [:admin, @provider], local: true do |f| %>
    <% if @provider.errors.any? %>
      <%= render FlatPack::Alert::Component.new(
        style: :danger,
        title: "#{pluralize(@provider.errors.count, "error")} prohibited this provider from being saved:",
        class: "mb-6"
      ) do %>
        <ul class="list-disc list-inside mt-2 space-y-1 text-sm">
          <% @provider.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated, class: "mb-6") do |card| %>
      <% card.header do %>
        <h5 class="font-semibold">Basic Information</h5>
      <% end %>
      <% card.body do %>
        <div class="space-y-6">
          <div>
            <%= render FlatPack::TextInput::Component.new(
              name: "provider[name]",
              label: "Name",
              placeholder: "stripe",
              required: true
            ) %>
            <p class="text-xs text-gray-500 mt-2">Unique identifier (lowercase, underscores only). Example: stripe, openai, github. Display name and description should be configured in the provider's YAML file.</p>
          </div>

          <div>
            <%= hidden_field_tag "provider[active]", "0" %>
            <%= render FlatPack::Checkbox::Component.new(
              name: "provider[active]",
              value: "1",
              label: "Provider is active",
              checked: true
            ) %>
            <p class="text-xs text-gray-500 mt-2">Inactive providers won't accept webhooks</p>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated, class: "mb-6") do |card| %>
      <% card.header do %>
        <h5 class="font-semibold">Authentication</h5>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::Alert::Component.new(style: :info) do %>
          <strong>ℹ️ Note:</strong> A secure token will be automatically generated when you save this provider.
          You'll use this token in the webhook URL. The signing secret should be configured in the provider's YAML file.
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated, class: "mb-6") do |card| %>
      <% card.header do %>
        <h5 class="font-semibold">Rate Limiting (optional)</h5>
      <% end %>
      <% card.body do %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
          <div>
            <%= render FlatPack::NumberInput::Component.new(
              name: "provider[rate_limit_requests]",
              label: "Rate Limit (requests)",
              value: 100,
              placeholder: "100"
            ) %>
          </div>
          <div>
            <%= render FlatPack::NumberInput::Component.new(
              name: "provider[rate_limit_period]",
              label: "Rate Limit (period in seconds)",
              value: 60,
              placeholder: "60"
            ) %>
          </div>
        </div>
        <p class="text-xs text-gray-500">Rate limit: Maximum number of requests allowed within the specified period. Default: 100 requests per 60 seconds</p>
      <% end %>
    <% end %>

    <div class="flex gap-2">
      <%= render FlatPack::Button::Component.new(
        text: "Create Provider",
        style: :primary,
        type: "submit"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Cancel",
        url: admin_providers_path,
        style: :secondary
      ) %>
    </div>
  <% end %>
</div>
