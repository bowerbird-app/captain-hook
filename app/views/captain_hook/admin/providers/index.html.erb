<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pt-4">
  <%= render FlatPack::PageHeader::Component.new(title: "Webhook Providers") %>

  <% if @providers.any? %>
    <%= render FlatPack::Table::Component.new(data: @providers) do |table| %>
      <% table.column(title: "Name", html: ->(provider) { provider.name }) %>
      <% table.column(title: "Display Name", html: ->(provider) { CaptainHook.configuration.provider(provider.name)&.display_name || provider.name.titleize }) %>
      
      <% table.column(title: "Status", html: ->(provider) {
        db_provider = @db_providers[provider.name]
        if db_provider&.active?
          render(FlatPack::Badge::Component.new(text: "Active", style: :success))
        else
          render(FlatPack::Badge::Component.new(text: "Inactive", style: :default))
        end
      }) %>
      
      <% table.column(title: "Security", html: ->(provider) {
        provider_config = CaptainHook.configuration.provider(provider.name)
        if provider_config&.verifier_class.present?
          render(FlatPack::Badge::Component.new(text: "Enabled", style: :success))
        else
          render(FlatPack::Badge::Component.new(text: "None", style: :default))
        end
      }) %>
      
      <% table.column(title: "Actions", html: ->(provider) {
        db_provider = @db_providers[provider.name]
        if db_provider
          link_to(db_provider.actions.count, admin_provider_actions_path(db_provider))
        else
          '0'
        end
      }) %>
      
      <% table.column(title: "Operations", html: ->(provider) {
        db_provider = @db_providers[provider.name]
        if db_provider
          render(FlatPack::Button::Component.new(
            text: "View",
            url: url_for([:admin, db_provider]),
            style: :ghost,
            size: :md
          ))
        else
          ''
        end
      }) %>
    <% end %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(style: :info, title: "No providers configured yet.") do %>
      <p class="text-sm mt-1">Providers are automatically discovered from YAML files in the <code class="bg-gray-100 px-1 rounded text-xs">captain_hook/&lt;provider&gt;/&lt;provider&gt;.yml</code> directory on application boot. Create a provider YAML file and restart the server to add providers.</p>
    <% end %>
  <% end %>
</div>
