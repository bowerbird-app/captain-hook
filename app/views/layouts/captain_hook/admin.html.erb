<!DOCTYPE html>
<html class="h-full">
  <head>
    <title>CaptainHook Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS with FlatPack styles -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "captain_hook/variables", "data-turbo-track": "reload" %>
    
    <!-- JavaScript -->
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
    
    <%= yield :head %>
  </head>

  <body class="h-full bg-gray-50">
    <% current_section = case controller_name
      when "providers" then "Providers"
      when "incoming_events" then "Incoming Events"
      when "sandbox" then "Sandbox"
      when "actions" then "Actions"
      else "Admin"
    end %>

    <%= render FlatPack::SidebarLayout::Component.new(side: :left, storage_key: "captain-hook-admin-sidebar") do |layout| %>
      <% layout.sidebar do %>
        <%= render FlatPack::Sidebar::Component.new do |sidebar| %>
          <% sidebar.header do %>
            <%= render FlatPack::Sidebar::Header::Component.new(
              brand_abbr: "CH",
              title: "CaptainHook",
              subtitle: "Admin"
            ) %>
          <% end %>

          <% sidebar.items do %>
            <nav class="py-4 space-y-1" aria-label="CaptainHook admin navigation">
              <%= render FlatPack::Sidebar::Item::Component.new(
                label: "Providers",
                href: captain_hook.admin_providers_path,
                icon: :folder,
                active: controller_name == "providers"
              ) %>
              <%= render FlatPack::Sidebar::Item::Component.new(
                label: "Incoming Events",
                href: captain_hook.admin_incoming_events_path,
                icon: :inbox,
                active: controller_name == "incoming_events"
              ) %>
              <%= render FlatPack::Sidebar::Item::Component.new(
                label: "Sandbox",
                href: captain_hook.admin_sandbox_path,
                icon: :beaker,
                active: controller_name == "sandbox"
              ) %>
            </nav>
          <% end %>
        <% end %>
      <% end %>

      <% layout.top_nav do %>
        <%= render FlatPack::TopNav::Component.new do |nav| %>
          <% nav.left do %>
            <%= render FlatPack::Button::Component.new(
              icon: "menu",
              icon_only: true,
              style: :ghost,
              size: :md,
              aria: {label: "Toggle sidebar"},
              data: {
                "flat-pack--sidebar-layout-target": "mobileToggle",
                action: "click->flat-pack--sidebar-layout#toggleMobile"
              },
              class: "md:hidden"
            ) %>

            <div class="flex flex-col">
              <span class="text-sm font-semibold text-(--surface-content-color)">CaptainHook Admin</span>
              <span class="text-xs text-(--surface-muted-content-color)"><%= current_section %></span>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% layout.main do %>
        <% if flash.any? %>
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <% flash.each do |type, message| %>
              <% 
                alert_style = case type.to_s
                when 'notice' then :primary
                when 'alert', 'error' then :danger
                when 'warning' then :warning
                when 'success' then :success
                else :primary
                end
              %>
              <%= render FlatPack::Alert::Component.new(
                style: alert_style,
                class: "mb-4"
              ) do %>
                <%= simple_format(message, {}, wrapper_tag: "div", sanitize: false) %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <%= yield %>
      <% end %>
    <% end %>
  </body>
</html>
